<Window x:Class="FilterCopy.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FilterCopy" Title="FilterCopy — フィルタして貼り付け" Width="820" Height="650" MinWidth="600" MinHeight="420" Closing="WindowClosing" ThemeMode="System" Icon="/FilterCopy;component/Assets/FilterCopy.ico">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
      <Button DockPanel.Dock="Right" Content="バージョン情報" Click="ShowAbout" Margin="12,0,0,0" Padding="10,4"/>
      <TextBlock x:Name="DestinationLabel" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,10">
      <TextBlock Text="検索  " VerticalAlignment="Center"/>
      <ComboBox x:Name="Search" IsEditable="True" IsTextSearchEnabled="False" TextBoxBase.TextChanged="FilterChanged" SelectionChanged="HistorySelected" ToolTip="検索条件の履歴"/>
    </DockPanel>
    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
      <RadioButton x:Name="NormalToggle" GroupName="SearchMode" Content="通常" IsChecked="True" Margin="0,0,14,0" Click="FilterChanged" ToolTip="入力した文字を含むファイルを検索"/>
      <RadioButton x:Name="WildcardToggle" GroupName="SearchMode" Content="ワイルドカード" Margin="0,0,14,0" Click="FilterChanged" ToolTip="例: *.dll（* は任意の文字列、? は任意の1文字）。名前全体に一致するものを検索"/>
      <RadioButton x:Name="RegexToggle" GroupName="SearchMode" Content="正規表現" Margin="0,0,18,0" Click="FilterChanged"/>
      <CheckBox x:Name="CaseToggle" Content="大文字小文字を区別" Margin="0,0,18,0" Click="FilterChanged"/>
      <CheckBox x:Name="PathToggle" Content="相対パスを検索" Click="FilterChanged"/>
    </WrapPanel>
    <TextBlock Grid.Row="3" x:Name="ErrorLabel" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TreeView Grid.Row="4" x:Name="FilesTree" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
      <TreeView.Resources><HierarchicalDataTemplate DataType="{x:Type local:TreeNode}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Name}" ToolTip="{Binding Path}"/></HierarchicalDataTemplate></TreeView.Resources>
      <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}"><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="IsExpanded" Value="True"/></Style></TreeView.ItemContainerStyle>
    </TreeView>
    <DockPanel Grid.Row="5" Margin="0,14,0,0" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="WarningsButton" Content="走査の詳細" Click="ShowWarnings" Margin="0,0,10,0" Visibility="Collapsed"/>
        <Button x:Name="CancelButton" Content="閉じる" Width="90" Click="CloseWindow" Margin="0,0,10,0"/>
        <Button x:Name="CopyButton" Content="コピー" Width="100" IsEnabled="False" Click="Copy" IsDefault="True"/>
      </StackPanel>
      <TextBlock x:Name="Status" VerticalAlignment="Center" Text="走査中…"/>
    </DockPanel>
  </Grid>
</Window>
